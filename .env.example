# FedTone environment template. Copy to .env and fill in locally.
# Never commit real values. Placeholders only.
# Nested groups use a double underscore: FEDTONE_<GROUP>__<FIELD>.

# development | test | production
FEDTONE_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
FEDTONE_LOG_LEVEL=INFO

FEDTONE_DATABASE__URL=sqlite:///./data/fedtone.db

# OpenAI-compatible LLM provider. API key and model are required when FEDTONE_ENV=production.
FEDTONE_LLM__BASE_URL=
FEDTONE_LLM__API_KEY=
FEDTONE_LLM__MODEL=
FEDTONE_LLM__TEMPERATURE=0.0
FEDTONE_LLM__TIMEOUT_SECONDS=60
FEDTONE_LLM__MAX_RETRIES=2
FEDTONE_LLM__BACKOFF_SECONDS=1.0
# Valid analyses below this confidence are stored but sent to human review.
FEDTONE_LLM__MIN_CONFIDENCE=0.6

# Official-source HTTP behaviour (bounded retry with exponential backoff).
FEDTONE_SOURCES__USER_AGENT=FedTone/0.1 (central-bank communication research)
FEDTONE_SOURCES__TIMEOUT_SECONDS=30
FEDTONE_SOURCES__MAX_RETRIES=3
FEDTONE_SOURCES__BACKOFF_SECONDS=1.0
# JSON list of listing pages scanned for FOMC statement links.
FEDTONE_SOURCES__FOMC_LISTING_URLS=["https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm"]

FEDTONE_SCHEDULER__ENABLED=false
FEDTONE_SCHEDULER__INGESTION_INTERVAL_MINUTES=60

# Market data: none | fred (public FRED CSV download, no key needed) | csv (local FRED-format
# files named <SYMBOL>.csv in FEDTONE_MARKET_DATA__CSV_DIRECTORY).
FEDTONE_MARKET_DATA__PROVIDER=none
FEDTONE_MARKET_DATA__API_KEY=
FEDTONE_MARKET_DATA__CSV_DIRECTORY=./data/market
FEDTONE_MARKET_DATA__TIMEOUT_SECONDS=30
FEDTONE_MARKET_DATA__MAX_RETRIES=3
FEDTONE_MARKET_DATA__BACKOFF_SECONDS=1.0
# Event windows in return days relative to the event session T ([0,+1] = close T-1 to close T+1).
FEDTONE_MARKET_DATA__WINDOWS=["[0,0]","[0,+1]","[0,+5]"]
# Optional: excess returns versus this price series (same trading calendar), e.g. SP500.
FEDTONE_MARKET_DATA__BENCHMARK_SYMBOL=
FEDTONE_MARKET_DATA__ANALOGUE_TOP_K=5
FEDTONE_MARKET_DATA__ANALOGUE_MIN_SAMPLE=3
# Instruments default to SP500, DGS2, DGS10 and DTWEXBGS (FRED ids); override with a JSON list
# of {"symbol","name","kind","calendar","observation_time"} in FEDTONE_MARKET_DATA__INSTRUMENTS.
